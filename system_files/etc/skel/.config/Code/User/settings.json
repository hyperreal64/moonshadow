{
    "workbench.startupEditor": "none",
    "editor.formatOnSave": true,
    "editor.fontFamily": "'AdwaitaMono Nerd Font Mono', 'Droid Sans Mono', monospace",
    "editor.formatOnPaste": true,
    "editor.minimap.enabled": false,
    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,
    "workbench.editor.closeOnFileDelete": true,
    "workbench.settings.showAISearchToggle": false,
    "workbench.browser.searchEngine": "duckduckgo",
    "workbench.browser.enableChatTools": false,
    "window.restoreWindows": "preserve",
    "window.zoomLevel": 1,
    "chat.agent.enabled": false,
    "terminal.integrated.allowInUntrustedWorkspace": true,
    "terminal.integrated.copyOnSelection": true,
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.tabs.allowAgentCliTitle": false,
    "terminal.integrated.tabStopWidth": 4,
    "notebook.formatOnSave.enabled": true,
    "notebook.output.wordWrap": true,
    "security.workspace.trust.untrustedFiles": "open",
    "html.format.templating": true,
    "workbench.colorTheme": "Catppuccin Mocha",
    "redhat.telemetry.enabled": false
}